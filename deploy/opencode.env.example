# Comma-separated exact origins approved for proxying.
OPENCODE_ALLOWED_SERVERS=http://139.180.175.60:4096,http://100.97.224.96:4096

# Unified Bun/Hono Web UI runtime. Bind to loopback when Caddy is in front.
WEBUI_BIND_HOST=127.0.0.1
WEBUI_PORT=3000

# Public deployments must enable the server-only Basic Auth boundary.
# Generate the scrypt hash out of band; never put the cleartext password in
# this file or in frontend configuration.
WEBUI_AUTH_MODE=basic
WEBUI_AUTH_REQUIRED=1
WEBUI_AUTH_USERNAME=operator
WEBUI_AUTH_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<base64url-derived-key>

# TEST ONLY: disables credential encryption and stores credentials as plaintext.
# Never enable this in production. APP_ENCRYPTION_KEY remains required otherwise.
# APP_ENCRYPTION_DISABLED=1

# The standalone proxy's port is intentionally not part of the normal Web UI
# deployment. Configure OPENCODE_PROXY_PORT only for optional split/debug mode.
