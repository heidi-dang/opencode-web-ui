[Unit]
Description=OPTIONAL DEBUG / LEGACY ONLY - OpenCode standalone proxy
After=network-online.target
Wants=network-online.target

# Do not enable this unit for normal production Web UI operation. The unified
# Bun/Hono service owns the browser gateway and control plane.

[Service]
Type=simple
WorkingDirectory=/srv/opencode-web-ui
EnvironmentFile=/etc/opencode-web-ui/opencode.env
ExecStart=/usr/local/bin/bun run scripts/opencode-proxy.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
